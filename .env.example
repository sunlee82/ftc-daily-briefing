# 실제 키는 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.

# 웹/뉴스 검색 — serper.dev (필수: 없으면 수집 단계에서 오류)
SERPER_API_KEY=

# 이 도구는 Claude API를 쓰지 않습니다. 웹 도구(localhost:4173)는 원문 그대로
# 수집만 하고, 제목/요약 다듬기·위원회 소식 PDF 요약·최종 배포는 Claude Code
# (구독 세션)가 tool/.drafts/에 저장된 초안을 이어받아 수행합니다.

# 서버 포트 (선택, 기본값 4173)
PORT=
